# Angular frontend
E2E_BASE_URL=http://localhost:4200

# Direct backend URL for API fixture setup and assertions
E2E_API_URL=http://localhost:8080

# Test users - existing users in the test database
E2E_COACH_USERNAME=coach
E2E_COACH_PASSWORD=CHANGE_ME
E2E_USER_USERNAME=user
E2E_USER_PASSWORD=CHANGE_ME

# PostgreSQL - fixture ownership, persistence and cleanup verification
E2E_DB_HOST=localhost
E2E_DB_PORT=5432
E2E_DB_NAME=workouts_test
E2E_DB_USER=postgres
E2E_DB_PASSWORD=CHANGE_ME
E2E_DB_SSL=false

# Admin credentials are required by the full suite
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=CHANGE_ME

# UI language used by the tests
E2E_LANGUAGE=hu

# P1 real SMTP acceptance tests (see README_P1.md)
E2E_MAILBOX_URL=http://127.0.0.1:8025
# Export these when running npm run mailbox; the script does not load .env.
# E2E_SMTP_PORT=1025
# E2E_MAILBOX_PORT=8025
