{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "playwright.config.ts",
    "global-setup.ts",
    "tests/**/*.ts",
    "playwright.contract.config.ts",
    "ui-contract/**/*.ts",
    "playwright.auth.config.ts",
    "playwright.frontend.config.ts",
    "playwright.live-api.config.ts",
    "live-api/**/*.ts"
  ]
}
